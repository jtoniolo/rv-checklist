# Copy this file to `.env` at the repo root and fill in the values — both the
# API (@nestjs/config) and the web app (next.config.js) read the root `.env`,
# and it carries vars for both. `.env` is gitignored — never commit real
# secrets. The dev Google OAuth client is a one-time manual setup in the Google
# Cloud Console (out of scope for the code); paste its client id here.

# --- API ---
# Port the NestJS API listens on.
PORT=3000
# Origin the browser loads the web app from; allowed through CORS so the browser
# can call the API directly with its bearer token (ADR-0002).
WEB_ORIGIN=http://localhost:4200

# --- Google OAuth (dev client) ---
# OAuth 2.0 "Web application" client id. One Tap ID tokens are verified against
# it server-side. Authorize http://localhost:4200 as a JavaScript origin.
GOOGLE_CLIENT_ID=your-dev-client-id.apps.googleusercontent.com
# Client secret from the same Google Cloud Console "Web application" credential.
# One Tap (ADR-0002) only needs the id; the MCP OAuth flow (ADR-0024) needs both.
GOOGLE_CLIENT_SECRET=your-dev-client-secret

# --- Google Maps (ADR-0025) ---
# Maps Platform API key for trip leg-distance fetches. A plain API key (not an
# OAuth credential), from the same Google Cloud project: enable the Routes API
# and Places API (New), then Credentials → Create API key, restricted to those
# two APIs, application restriction None (home egress IP is dynamic), and
# daily quotas capped inside the free tier (Routes 300/day, Places 150/day).
GOOGLE_MAPS_API_KEY=your-maps-api-key

# --- First-party JWT (ADR-0002) ---
# Secret the access token is signed with. Use a long random string,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
# Access-token lifetime in seconds (short; the refresh token keeps you signed in).
JWT_ACCESS_TTL=900
# Refresh-token lifetime in days (long, Gmail-like — you rarely re-sign-in).
REFRESH_TTL_DAYS=180
# Reuse interval in seconds for a rotated-out refresh token (ADR-0028): a
# replay inside this window still refreshes, so a rotation response lost on an
# unreliable network self-heals instead of ending the session.
REFRESH_REUSE_INTERVAL_SECONDS=120

# --- Postgres (matches tools/dev/docker-compose.yml) ---
DATABASE_URL=postgres://rv:rv@localhost:5432/rv_checklist

# --- Garage S3 attachment storage (ADR-0026, ticket #110) ---
# Garage runs on the home lab host (not in the cluster); 3900 is its S3 API
# port, addressed path-style. Local dev uses the dedicated -local bucket; the
# key pair comes from the Garage provisioning (ticket #110) and in the cluster
# lives in Vault under the operator's private KV path (note: the Vault key for
# S3_SECRET_ACCESS_KEY is `s3_access_key`, not a lowercase rename).
S3_ENDPOINT=http://your-garage-host:3900
S3_BUCKET=rv-checklist-local
S3_ACCESS_KEY_ID=your-garage-key-id
S3_SECRET_ACCESS_KEY=your-garage-secret-key

# --- MCP OAuth 2.1 (ADR-0024) ---
# Bare-origin issuer URL for the MCP authorization server. Must have NO path
# component (claude.ai discovery bug). In production this is the Tunnel hostname.
MCP_ISSUER_URL=http://localhost:3000
# HS256 signing secret for MCP OAuth JWTs. Separate from JWT_SECRET.
# Use a long random string, e.g. `openssl rand -base64 48`.
MCP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# MCP resource URL (the connector endpoint). Defaults to <MCP_ISSUER_URL>/api/mcp.
# MCP_RESOURCE_URL=http://localhost:3000/api/mcp
# Comma-separated allowlist of redirect URIs accepted during dynamic client
# registration. Loopback URIs (http://localhost, http://127.0.0.1) are always
# accepted regardless of this list. Default includes the Claude callback URIs.
# MCP_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# --- Web (Next.js) ---
# NEXT_PUBLIC_* values are exposed to the browser at build time.
# Same Google client id as GOOGLE_CLIENT_ID above.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-dev-client-id.apps.googleusercontent.com
# Base URL the browser calls the API at (note the /api global prefix).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
