{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "types": ["jest", "node"],
    "forceConsistentCasingInFileNames": true,
    // Matches `tsconfig.lib.json` (issue #152's outbox specs use real
    // `IDBDatabase`/`IDBFactory` types against `fake-indexeddb`); the base
    // config's `lib` is `es2022` only.
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/test-setup.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
