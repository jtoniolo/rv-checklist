{
  "name": "@rv-checklist/web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "copy-powersync-assets": "powersync-web copy-assets -o public",
    "postinstall": "powersync-web copy-assets -o public",
    "build-sw": "node sw/build.mjs",
    "typecheck": "tsc -p sw/tsconfig.json --noEmit"
  },
  "nx": {
    "targets": {
      "copy-powersync-assets": {
        "cache": true,
        "inputs": [
          {
            "externalDependencies": [
              "@powersync/web"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/public/@powersync"
        ]
      },
      "build-sw": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      },
      "typecheck": {
        "//": "`sw/` only. Everything under `src/` is typechecked by `next build`, which runs tsc over `tsconfig.json`; `sw/` is outside that config's `include` and is bundled by esbuild, which strips types without reading them. Without this target a type error in the service worker source would compile straight into `public/sw.js` with the whole gate green.",
        "cache": true,
        "inputs": [
          "{projectRoot}/sw/**/*",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "externalDependencies": [
              "typescript",
              "serwist"
            ]
          }
        ],
        "outputs": []
      },
      "dev": {
        "dependsOn": [
          "copy-powersync-assets"
        ],
        "options": {
          "port": 4200
        }
      },
      "build": {
        "dependsOn": [
          "^build",
          "copy-powersync-assets"
        ]
      },
      "start": {
        "dependsOn": [
          "build-sw"
        ]
      },
      "serve-static": {
        "dependsOn": [
          "build-sw"
        ]
      },
      "build:worker": {
        "dependsOn": [
          "copy-powersync-assets"
        ]
      },
      "preview:worker": {
        "dependsOn": [
          "copy-powersync-assets"
        ]
      }
    },
    "tags": [
      "scope:web",
      "type:app"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@rv-checklist/domain": "workspace:*",
    "@rv-checklist/web-data-access": "workspace:*",
    "@rv-checklist/web-ui": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@powersync/web": "^2.2.0",
    "esbuild": "^0.28.2",
    "serwist": "^9.5.12",
    "wrangler": "^4.123.0"
  }
}
